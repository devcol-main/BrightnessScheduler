<Window x:Class="BrightnessScheduler.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BrightnessScheduler.Localization"
        xmlns:c="clr-namespace:BrightnessScheduler.Controls"
        xmlns:vm="clr-namespace:BrightnessScheduler.ViewModels"
        Title="Brightness Scheduler"
        Width="1060" Height="760" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation ================= -->
        <DockPanel Grid.Column="0" Margin="10,18,8,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,26">
                <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Brightness" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Scheduler" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- mini status at the bottom of the nav -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" Margin="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{Binding ActiveLevel, Converter={StaticResource LevelBrush}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" FontSize="14" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding ActiveSubtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{l:T Nav_Dashboard}" GroupName="nav"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE787;" Content="{l:T Nav_Schedule}" GroupName="nav"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{l:T Nav_Settings}" GroupName="nav"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE946;" Content="{l:T Nav_About}" GroupName="nav"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource IntEquals}, ConverterParameter=3}" />
            </StackPanel>
        </DockPanel>

        <!-- ================= Content ================= -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>

                <!-- ============ Dashboard ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource IntVis}, ConverterParameter=0}">
                    <StackPanel Margin="36,28,36,36">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Nav_Dashboard}" />

                        <!-- Hero / status -->
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="32" VerticalAlignment="Center"
                                        Background="{Binding ActiveLevel, Converter={StaticResource LevelBrush}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" FontSize="28"
                                               Foreground="White" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T CurrentSchedule}" />
                                    <TextBlock Text="{Binding ActiveTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ActiveSubtitle}" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding NextText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyNowCommand}" AutomationProperties.Name="{l:T ApplyNow}"
                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolVisInv}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{l:T ApplyNow}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PauseButton" Margin="8,0,0,0" Padding="12,7" Click="PauseButton_Click" AutomationProperties.Name="{l:T Pause}"
                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolVisInv}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{l:T Pause}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="8,2,0,0" />
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="PauseMenu">
                                                <MenuItem Header="{l:T Pause1h}" Command="{Binding Pause1hCommand}" />
                                                <MenuItem Header="{l:T PauseNext}" Command="{Binding PauseNextCommand}" />
                                                <MenuItem Header="{l:T PauseForever}" Command="{Binding PauseForeverCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Style="{StaticResource AccentButton}" Command="{Binding ResumeCommand}" AutomationProperties.Name="{l:T Resume}"
                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{l:T Resume}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Timeline -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{l:T TodayTimeline}" />
                                <c:ScheduleTimeline Margin="0,10,0,0"
                                                    Segments="{Binding TimelineSegments}" NowMinute="{Binding NowMinute}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    MarkerBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Displays -->
                        <Grid Margin="0,30,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Displays}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{l:T DisplaysDesc}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Command="{Binding RefreshDisplaysCommand}" AutomationProperties.Name="{l:T Refresh}" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T Refresh}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8"
                                    Visibility="{Binding IsDetecting, Converter={StaticResource BoolVis}}">
                            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{l:T Detecting}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="{l:T NoDisplays}" Margin="0,4,0,8"
                                   Visibility="{Binding HasNoDisplays, Converter={StaticResource BoolVis}}" />

                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="20,16,20,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource CardHeader}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Brightness -->
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{l:T Brightness}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center" IsEnabled="{Binding SupportsBrightness}"
                                                        Value="{Binding Brightness, Mode=TwoWay}"
                                                        Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Text="{l:T NotSupported}" VerticalAlignment="Center"
                                                           Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolVisInv}}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Brightness}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolVis}}" />
                                            </Grid>

                                            <!-- Contrast -->
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE793;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{l:T Contrast}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center" IsEnabled="{Binding SupportsContrast}"
                                                        Value="{Binding Contrast, Mode=TwoWay}"
                                                        Visibility="{Binding SupportsContrast, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Text="{l:T NotSupported}" VerticalAlignment="Center"
                                                           Visibility="{Binding SupportsContrast, Converter={StaticResource BoolVisInv}}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Contrast}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Visibility="{Binding SupportsContrast, Converter={StaticResource BoolVis}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Schedule ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource IntVis}, ConverterParameter=1}">
                    <StackPanel Margin="36,28,36,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T ScheduleTitle}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{l:T ScheduleDesc}" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding AddEntryCommand}" AutomationProperties.Name="{l:T AddEntry}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T AddEntry}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,20,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{l:T TodayTimeline}" />
                                <c:ScheduleTimeline Margin="0,10,0,0"
                                                    Segments="{Binding TimelineSegments}" NowMinute="{Binding NowMinute}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    MarkerBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Secondary}" Text="{l:T NoEntries}" Margin="0,8"
                                   Visibility="{Binding HasNoEntries, Converter={StaticResource BoolVis}}" />

                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8,0,0,8" Background="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                            <StackPanel Grid.Column="1" Margin="18,14,18,14">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <!-- header row -->
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding PreviewCommand}" AutomationProperties.Name="{l:T Preview}" Padding="12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,6,0" />
                                                                <TextBlock Text="{l:T Preview}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource SubtleButton}" Command="{Binding DeleteCommand}" AutomationProperties.Name="{l:T Delete}" Margin="6,0,0,0"
                                                                ToolTip="{l:T Delete}">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                                  ToolTip="{l:T EntryEnabled}" />
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="14,0,16,0"
                                                                 VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="14" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <ComboBox ItemsSource="{x:Static vm:EntryViewModel.HourOptions}" SelectedItem="{Binding Hour}"
                                                                  ItemStringFormat="00" Width="76" VerticalAlignment="Center" ToolTip="{l:T StartsAt}" />
                                                        <TextBlock Text=":" FontSize="16" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <ComboBox ItemsSource="{x:Static vm:EntryViewModel.MinuteOptions}" SelectedItem="{Binding Minute}"
                                                                  ItemStringFormat="00" Width="76" VerticalAlignment="Center" ToolTip="{l:T StartsAt}"
                                                                  MaxDropDownHeight="300" />
                                                        <Border Style="{StaticResource Badge}" Margin="14,0,0,0"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{l:T ActiveBadge}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- days -->
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T RepeatOn}" Width="72" VerticalAlignment="Center" />
                                                    <ItemsControl ItemsSource="{Binding Days}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DayViewModel}">
                                                                <ToggleButton Style="{StaticResource DayChip}" Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- per-display targets -->
                                                <ItemsControl ItemsSource="{Binding Targets}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TargetViewModel}">
                                                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28" />
                                                                        <ColumnDefinition Width="170" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="24" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Display.Glyph}"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Display.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" Margin="0,0,8,0" />

                                                                    <Grid Grid.Column="2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="34" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox Content="{l:T Brightness}" IsChecked="{Binding SetBrightness}" MinWidth="78"
                                                                                  IsEnabled="{Binding SupportsBrightness}" VerticalAlignment="Center" />
                                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                                Value="{Binding Brightness, Mode=TwoWay}" IsEnabled="{Binding SetBrightness}"
                                                                                VerticalAlignment="Center" Margin="4,0" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Brightness}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    </Grid>

                                                                    <Grid Grid.Column="4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="34" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox Content="{l:T Contrast}" IsChecked="{Binding SetContrast}" MinWidth="78"
                                                                                  IsEnabled="{Binding SupportsContrast}" VerticalAlignment="Center" />
                                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                                Value="{Binding Contrast, Mode=TwoWay}" IsEnabled="{Binding SetContrast}"
                                                                                VerticalAlignment="Center" Margin="4,0" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Contrast}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Settings ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource IntVis}, ConverterParameter=2}">
                    <StackPanel Margin="36,28,36,36">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T SettingsTitle}" />

                        <TextBlock Style="{StaticResource CardHeader}" Text="{l:T General}" Margin="2,24,0,8" />

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" Width="220" SelectedIndex="{Binding LanguageIndex}" VerticalAlignment="Center">
                                    <ComboBoxItem Content="{l:T Lang_Auto}" />
                                    <ComboBoxItem Content="한국어" />
                                    <ComboBoxItem Content="English" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Language}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T LanguageDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" Width="220" SelectedIndex="{Binding ThemeIndex}" VerticalAlignment="Center">
                                    <ComboBoxItem Content="{l:T Theme_System}" />
                                    <ComboBoxItem Content="{l:T Theme_Light}" />
                                    <ComboBoxItem Content="{l:T Theme_Dark}" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Theme}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T ThemeDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAtStartup}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T RunAtStartup}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T RunAtStartupDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Notifications}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T NotificationsDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Behavior}" Margin="2,24,0,8" />

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TransitionText}" Width="90" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Slider Width="220" Minimum="0" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding TransitionSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Transition}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T TransitionDesc}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReapplyOnSystemEvents}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Reapply}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T ReapplyDesc}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <ComboBox x:Name="EnforceCombo" DockPanel.Dock="Right" Width="220" SelectedIndex="{Binding EnforceIndex}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Enforce}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T EnforceDesc}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding OpenDataFolderCommand}" AutomationProperties.Name="{l:T Open}" VerticalAlignment="Center" Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:T Open}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T DataFolder}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DataFolder}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding UninstallCommand}" VerticalAlignment="Center" Padding="14,6"
                                        AutomationProperties.Name="{l:T Uninstall}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:T Uninstall}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,16,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Uninstall}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T UninstallDesc}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ About ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedPage, Converter={StaticResource IntVis}, ConverterParameter=3}">
                    <StackPanel Margin="36,28,36,36">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Nav_About}" />

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/logo.png" Width="72" Height="72" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="{l:T AppName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" Margin="0,2,0,10" />
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T AboutDesc}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource AccentButton}" Command="{Binding OpenGitHubCommand}" AutomationProperties.Name="{l:T ViewOnGitHub}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{l:T ViewOnGitHub}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenLogCommand}" AutomationProperties.Name="{l:T OpenLog}" Margin="8,0,0,0" Padding="14,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="{l:T OpenLog}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource CardHeader}" Text="{l:T Tips}" Margin="2,24,0,8" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Tip1}" />
                                </DockPanel>
                                <DockPanel Margin="0,8">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Tip2}" />
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{l:T Tip3}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Text="{l:T License}" Margin="2,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
