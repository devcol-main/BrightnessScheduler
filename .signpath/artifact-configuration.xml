<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration.
  Paste this into: SignPath › Project "BrightnessScheduler" › Artifact configurations.
  The GitHub workflow uploads dist/*.exe as a zip artifact, so the root element is <zip-file>.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Brightness Scheduler">
      <include path="BrightnessScheduler-*-win-x64.exe" />
      <include path="BrightnessScheduler-*-win-x64-small.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
